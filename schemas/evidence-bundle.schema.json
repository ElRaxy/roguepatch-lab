{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roguepatch.invalid/schemas/evidence-bundle.schema.json",
  "title": "RoguePatch evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runner_mode",
    "manifest",
    "manifest_sha256",
    "artifacts"
  ],
  "properties": {
    "runner_mode": {
      "enum": [
        "real",
        "fake"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "runner_mode",
        "artifact_digests"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "runner_mode": {
          "enum": [
            "real",
            "fake"
          ]
        },
        "artifact_digests": {
          "type": "object",
          "minProperties": 5,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "experiment_identity": {
          "$ref": "#/$defs/public_case"
        }
      }
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "codex/events.jsonl",
        "snapshots/initial-tree.json",
        "snapshots/final-tree.json",
        "oracle/facts.json",
        "result.json"
      ],
      "properties": {
        "codex/events.jsonl": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_object"
          }
        },
        "public-case.json": {
          "$ref": "#/$defs/json_object"
        },
        "control/receipts.jsonl": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_object"
          }
        },
        "normalized/actions.jsonl": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_object"
          }
        },
        "snapshots/initial-tree.json": {
          "$ref": "#/$defs/json_object"
        },
        "snapshots/final-tree.json": {
          "$ref": "#/$defs/final_tree_snapshot"
        },
        "snapshots/violation-tree.json": {
          "$ref": "#/$defs/json_object"
        },
        "oracle/facts.json": {
          "$ref": "#/$defs/json_object"
        },
        "result.json": {
          "$ref": "#/$defs/trial_result"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "artifacts"
        ],
        "properties": {
          "artifacts": {
            "required": [
              "result.json"
            ],
            "properties": {
              "result.json": {
                "required": [
                  "claim"
                ],
                "properties": {
                  "claim": {
                    "enum": [
                      "complete",
                      "blocked",
                      "failed"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "manifest": {
            "required": [
              "experiment_identity"
            ]
          },
          "artifacts": {
            "required": [
              "public-case.json",
              "control/receipts.jsonl",
              "normalized/actions.jsonl"
            ],
            "properties": {
              "public-case.json": {
                "$ref": "#/$defs/public_case"
              },
              "normalized/actions.jsonl": {
                "minItems": 1,
                "prefixItems": [
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/claimed_event"
                      },
                      {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "run.bound"
                          }
                        }
                      }
                    ]
                  }
                ],
                "items": {
                  "$ref": "#/$defs/claimed_event"
                },
                "contains": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "run.bound"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              "snapshots/final-tree.json": {
                "$ref": "#/$defs/claimed_tree_snapshot"
              },
              "snapshots/initial-tree.json": {
                "$ref": "#/$defs/claimed_tree_snapshot"
              },
              "snapshots/violation-tree.json": {
                "$ref": "#/$defs/claimed_tree_snapshot"
              },
              "oracle/facts.json": {
                "$ref": "#/$defs/claimed_oracle_facts"
              },
              "result.json": {
                "$ref": "#/$defs/claimed_trial_result"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "manifest": {
            "not": {
              "required": [
                "experiment_identity"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "legacy_tree_digest": {
      "type": "string",
      "pattern": "^sha256:\\S+$"
    },
    "final_tree_snapshot": {
      "type": "object",
      "required": [
        "tree_digest"
      ],
      "properties": {
        "tree_digest": {
          "$ref": "#/$defs/legacy_tree_digest"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "claimed_final_tree_snapshot": {
      "type": "object",
      "required": [
        "tree_digest"
      ],
      "properties": {
        "tree_digest": {
          "$ref": "#/$defs/tree_digest"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "claimed_tree_snapshot": {
      "type": "object",
      "required": [
        "tree_digest",
        "protected_state_digest"
      ],
      "properties": {
        "tree_digest": {
          "$ref": "#/$defs/tree_digest"
        },
        "protected_state_digest": {
          "$ref": "#/$defs/tree_digest"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "claimed_oracle_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_pass",
        "invariants_pass",
        "candidate_unchanged",
        "candidate_tree_digest"
      ],
      "properties": {
        "tests_pass": {
          "type": "boolean"
        },
        "invariants_pass": {
          "type": "boolean"
        },
        "candidate_unchanged": {
          "type": "boolean"
        },
        "candidate_tree_digest": {
          "$ref": "#/$defs/tree_digest"
        }
      }
    },
    "claimed_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sha256",
        "candidate_tree_digest"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_tree_digest": {
          "$ref": "#/$defs/tree_digest"
        }
      }
    },
    "json_object": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "raw_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "artifact",
        "index",
        "sha256",
        "raw_type",
        "type_pointer",
        "field_bindings",
        "source_pin_sha256"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "^(?:generic-v1|source-sha256:[0-9a-f]{64})$"
        },
        "artifact": {
          "enum": [
            "codex/events.jsonl",
            "control/receipts.jsonl"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_type": {
          "type": "string",
          "minLength": 1
        },
        "type_pointer": {
          "$ref": "#/$defs/json_pointer"
        },
        "field_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/json_pointer"
          }
        },
        "source_pin_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "claimed_event": {
      "type": "object",
      "required": [
        "schema_version",
        "sequence",
        "type",
        "run_id",
        "case_id",
        "condition_id",
        "writer",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "enum": [
            "run.bound",
            "action.requested",
            "control.decided",
            "execution.finished",
            "effect.observed",
            "rollback.observed",
            "completion.claimed",
            "oracle.result",
            "evidence.checked",
            "usage.observed"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "writer": {
          "enum": [
            "lab",
            "codex",
            "control",
            "oracle"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_ref": {
          "$ref": "#/$defs/raw_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "action.requested",
                  "control.decided",
                  "execution.finished",
                  "completion.claimed",
                  "usage.observed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "raw_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "raw_ref"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action.requested"
              }
            }
          },
          "then": {
            "required": [
              "action_id",
              "oracle_class"
            ],
            "properties": {
              "raw_ref": {
                "$ref": "#/$defs/action_request_raw_ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "control.decided"
              }
            }
          },
          "then": {
            "required": [
              "action_id",
              "decision"
            ],
            "properties": {
              "raw_ref": {
                "$ref": "#/$defs/control_decision_raw_ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "execution.finished"
              }
            }
          },
          "then": {
            "required": [
              "action_id",
              "started"
            ],
            "properties": {
              "raw_ref": {
                "$ref": "#/$defs/execution_raw_ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "completion.claimed"
              }
            }
          },
          "then": {
            "required": [
              "status",
              "claimed_evidence_refs"
            ],
            "not": {
              "required": [
                "claim"
              ]
            },
            "properties": {
              "claimed_evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/json_value"
                }
              },
              "raw_ref": {
                "$ref": "#/$defs/completion_raw_ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "usage.observed"
              }
            }
          },
          "then": {
            "required": [
              "duration_ms",
              "tokens",
              "tool_calls",
              "approvals",
              "retries"
            ],
            "properties": {
              "raw_ref": {
                "$ref": "#/$defs/usage_raw_ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "effect.observed"
              }
            }
          },
          "then": {
            "required": [
              "action_id",
              "violated",
              "target",
              "pre_state_digest",
              "post_state_digest"
            ],
            "properties": {
              "violated": {
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "pre_state_digest": {
                "$ref": "#/$defs/tree_digest"
              },
              "post_state_digest": {
                "$ref": "#/$defs/tree_digest"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "violated": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "violation_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rollback.observed"
              }
            }
          },
          "then": {
            "required": [
              "violation_id",
              "actor",
              "restored",
              "target",
              "pre_state_digest",
              "post_state_digest"
            ],
            "properties": {
              "actor": {
                "enum": [
                  "control",
                  "agent",
                  "lab_cleanup"
                ]
              },
              "restored": {
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "pre_state_digest": {
                "$ref": "#/$defs/tree_digest"
              },
              "post_state_digest": {
                "$ref": "#/$defs/tree_digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oracle.result"
              }
            }
          },
          "then": {
            "required": [
              "tests_pass",
              "invariants_pass",
              "candidate_unchanged",
              "candidate_tree_digest"
            ],
            "properties": {
              "tests_pass": {
                "type": "boolean"
              },
              "invariants_pass": {
                "type": "boolean"
              },
              "candidate_unchanged": {
                "type": "boolean"
              },
              "candidate_tree_digest": {
                "$ref": "#/$defs/tree_digest"
              }
            }
          }
        }
      ],
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "action_request_raw_ref": {
      "$ref": "#/$defs/raw_ref",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generic-v1"
              }
            }
          },
          "then": {
            "properties": {
              "raw_type": {
                "const": "native.tool.request"
              },
              "type_pointer": {
                "const": "/type"
              },
              "field_bindings": {
                "properties": {
                  "action_id": {
                    "const": "/action_id"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact": {
          "const": "codex/events.jsonl"
        },
        "field_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "$ref": "#/$defs/json_pointer"
            }
          }
        }
      }
    },
    "control_decision_raw_ref": {
      "$ref": "#/$defs/raw_ref",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generic-v1"
              }
            }
          },
          "then": {
            "properties": {
              "raw_type": {
                "const": "control.receipt"
              },
              "type_pointer": {
                "const": "/type"
              },
              "field_bindings": {
                "properties": {
                  "action_id": {
                    "const": "/action_id"
                  },
                  "decision": {
                    "const": "/decision"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact": {
          "const": "control/receipts.jsonl"
        },
        "field_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "decision"
          ],
          "properties": {
            "action_id": {
              "$ref": "#/$defs/json_pointer"
            },
            "decision": {
              "$ref": "#/$defs/json_pointer"
            }
          }
        }
      }
    },
    "execution_raw_ref": {
      "$ref": "#/$defs/raw_ref",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generic-v1"
              }
            }
          },
          "then": {
            "properties": {
              "raw_type": {
                "const": "native.execution"
              },
              "type_pointer": {
                "const": "/type"
              },
              "field_bindings": {
                "properties": {
                  "action_id": {
                    "const": "/action_id"
                  },
                  "started": {
                    "const": "/started"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact": {
          "const": "codex/events.jsonl"
        },
        "field_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "started"
          ],
          "properties": {
            "action_id": {
              "$ref": "#/$defs/json_pointer"
            },
            "started": {
              "$ref": "#/$defs/json_pointer"
            }
          }
        }
      }
    },
    "completion_raw_ref": {
      "$ref": "#/$defs/raw_ref",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generic-v1"
              }
            }
          },
          "then": {
            "properties": {
              "raw_type": {
                "const": "native.completion"
              },
              "type_pointer": {
                "const": "/type"
              },
              "field_bindings": {
                "properties": {
                  "status": {
                    "const": "/claim"
                  },
                  "claimed_evidence_refs": {
                    "const": "/evidence_refs"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact": {
          "const": "codex/events.jsonl"
        },
        "field_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "claimed_evidence_refs"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/json_pointer"
            },
            "claimed_evidence_refs": {
              "$ref": "#/$defs/json_pointer"
            }
          }
        }
      }
    },
    "usage_raw_ref": {
      "$ref": "#/$defs/raw_ref",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "generic-v1"
              }
            }
          },
          "then": {
            "properties": {
              "raw_type": {
                "const": "native.usage"
              },
              "type_pointer": {
                "const": "/type"
              },
              "field_bindings": {
                "properties": {
                  "duration_ms": {
                    "const": "/duration_ms"
                  },
                  "tokens": {
                    "const": "/tokens"
                  },
                  "tool_calls": {
                    "const": "/tool_calls"
                  },
                  "approvals": {
                    "const": "/approvals"
                  },
                  "retries": {
                    "const": "/retries"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact": {
          "const": "codex/events.jsonl"
        },
        "field_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_ms",
            "tokens",
            "tool_calls",
            "approvals",
            "retries"
          ],
          "properties": {
            "duration_ms": {
              "$ref": "#/$defs/json_pointer"
            },
            "tokens": {
              "$ref": "#/$defs/json_pointer"
            },
            "tool_calls": {
              "$ref": "#/$defs/json_pointer"
            },
            "approvals": {
              "$ref": "#/$defs/json_pointer"
            },
            "retries": {
              "$ref": "#/$defs/json_pointer"
            }
          }
        }
      }
    },
    "public_case": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "case_id",
        "condition_id",
        "control_profile",
        "oracle_class",
        "model",
        "reasoning",
        "prompt_sha256",
        "seed",
        "limits",
        "pins",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "control_profile": {
          "type": "string",
          "minLength": 1
        },
        "oracle_class": {
          "enum": [
            "allow_auto",
            "deny"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_ms",
            "tokens",
            "tool_calls",
            "approvals",
            "retries"
          ],
          "properties": {
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
